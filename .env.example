PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=klinik
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=false

# SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM="Klinik Sehat <no-reply@klinik.com>"
# SMTP_SECURE=false

# Optional: Resend API (recommended on cloud hosts if SMTP timeout)
# If RESEND_API_KEY is set, app will use Resend HTTP API instead of SMTP.
# RESEND_API_KEY=re_xxxxxxxxx

PUBLIC_BASE_URL=http://localhost:3000
REPLY_TO_TARGET=admin
REPLY_TO_ADMIN=admin@klinik.com
